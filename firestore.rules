rules_version = '2';

// Visionary Safe Sync v6 — role-based access for app version 3.0.15.

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verifiedUser() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email is string;
    }

    function isAdmin() {
      return verifiedUser()
        && exists(/databases/$(database)/documents/authorizedUsers/$(request.auth.uid))
        && get(/databases/$(database)/documents/authorizedUsers/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/authorizedUsers/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/authorizedUsers/$(request.auth.uid)).data.email == request.auth.token.email;
    }

    function isApprovedTechnician() {
      return verifiedUser()
        && exists(/databases/$(database)/documents/authorizedUsers/$(request.auth.uid))
        && get(/databases/$(database)/documents/authorizedUsers/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/authorizedUsers/$(request.auth.uid)).data.email == request.auth.token.email
        && (!get(/databases/$(database)/documents/authorizedUsers/$(request.auth.uid)).data.keys().hasAny(['role'])
          || get(/databases/$(database)/documents/authorizedUsers/$(request.auth.uid)).data.role == 'technician');
    }

    function canUseSharedShifts() {
      return isAdmin() || isApprovedTechnician();
    }

    function validAccessRequest(data, uid) {
      return data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'requestedAt'
        ])
        && data.keys().hasAll([
          'uid',
          'email',
          'displayName',
          'requestedAt'
        ])
        && data.uid == uid
        && data.email == request.auth.token.email
        && data.displayName is string
        && data.requestedAt == request.time;
    }

    function validAuthorizedUser(data, uid) {
      return data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'active',
          'role',
          'approvedAt',
          'approvedByUid'
        ])
        && data.keys().hasAll([
          'uid',
          'email',
          'displayName',
          'active',
          'role',
          'approvedAt',
          'approvedByUid'
        ])
        && data.uid == uid
        && data.email is string
        && data.displayName is string
        && data.active is bool
        && data.role == 'technician'
        && data.approvedAt == request.time
        && data.approvedByUid == request.auth.uid;
    }

    function validShiftDocument(data, shiftId) {
      return data.keys().hasOnly([
          'version',
          'date',
          'shift',
          'roster',
          'otSupport',
          'errorProof',
          'fixed',
          'technicians',
          'cellIds',
          'pms',
          'escalations',
          'superEscalations',
          'handoffNote',
          'schemaVersion',
          'syncProtocolVersion',
          'clientWriteId',
          'createdAt',
          'createdByUid',
          'createdByEmail',
          'updatedAt',
          'updatedByUid',
          'updatedByEmail',
          'taskAudit'
        ])
        && data.keys().hasAll([
          'version',
          'date',
          'shift',
          'roster',
          'otSupport',
          'errorProof',
          'fixed',
          'technicians',
          'cellIds',
          'pms',
          'escalations',
          'schemaVersion',
          'syncProtocolVersion',
          'clientWriteId',
          'createdAt',
          'createdByUid',
          'createdByEmail',
          'updatedAt',
          'updatedByUid',
          'updatedByEmail',
          'taskAudit'
        ])
        && data.version in [9, 10]
        && data.schemaVersion == 1
        && data.syncProtocolVersion == 6
        && data.clientWriteId is string
        && data.clientWriteId.size() >= 10
        && data.clientWriteId.size() <= 160
        && data.date is string
        && data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && data.shift in ['B1', 'B2', 'G1', 'G2']
        && shiftId == data.date + '_' + data.shift
        && data.roster is map
        && data.otSupport is list
        && data.errorProof is string
        && data.fixed is map
        && data.technicians is map
        && data.cellIds is map
        && data.pms is map
        && data.escalations is map
        && (!data.keys().hasAny(['superEscalations']) || data.superEscalations is map)
        && (!data.keys().hasAny(['handoffNote']) || data.handoffNote is string)
        && data.taskAudit is map
        && data.createdAt is timestamp
        && data.createdByUid is string
        && data.createdByEmail is string
        && data.updatedAt is timestamp
        && data.updatedByUid is string
        && data.updatedByEmail is string;
    }

    match /accessRequests/{uid} {
      allow get: if isAdmin()
        || (verifiedUser() && request.auth.uid == uid);
      allow list, delete: if isAdmin();
      allow create, update: if verifiedUser()
        && request.auth.uid == uid
        && validAccessRequest(request.resource.data, uid);
    }

    match /authorizedUsers/{uid} {
      allow get: if isAdmin()
        || (verifiedUser() && request.auth.uid == uid);
      allow list: if isAdmin();
      allow delete: if isAdmin() && uid != request.auth.uid;
      allow create, update: if isAdmin()
        && validAuthorizedUser(request.resource.data, uid);
    }

    match /shifts/{shiftId} {
      allow get, list: if canUseSharedShifts();

      allow create: if canUseSharedShifts()
        && validShiftDocument(request.resource.data, shiftId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.createdByEmail == request.auth.token.email
        && request.resource.data.updatedByEmail == request.auth.token.email;

      allow update: if canUseSharedShifts()
        && validShiftDocument(request.resource.data, shiftId)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.createdByEmail == resource.data.createdByEmail
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.updatedByEmail == request.auth.token.email
        && (!resource.data.keys().hasAny(['clientWriteId'])
          || request.resource.data.clientWriteId != resource.data.clientWriteId)
        && request.resource.data.diff(resource.data).affectedKeys().hasAll([
          'clientWriteId'
        ])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'version',
          'roster',
          'otSupport',
          'errorProof',
          'fixed',
          'technicians',
          'cellIds',
          'pms',
          'escalations',
          'superEscalations',
          'handoffNote',
          'syncProtocolVersion',
          'clientWriteId',
          'updatedAt',
          'updatedByUid',
          'updatedByEmail',
          'taskAudit'
        ]);

      allow delete: if isAdmin();
    }
  }
}

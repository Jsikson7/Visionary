rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verifiedUser() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email is string;
    }

    function isOwner() {
      return verifiedUser()
        && request.auth.token.email == 'jsikson@gmail.com';
    }

    function isApprovedTechnician() {
      return verifiedUser()
        && exists(/databases/$(database)/documents/authorizedUsers/$(request.auth.uid))
        && get(/databases/$(database)/documents/authorizedUsers/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/authorizedUsers/$(request.auth.uid)).data.email == request.auth.token.email;
    }

    function canUseSharedShifts() {
      return isOwner() || isApprovedTechnician();
    }

    function validAccessRequest(data, uid) {
      return data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'requestedAt'
        ])
        && data.keys().hasAll([
          'uid',
          'email',
          'displayName',
          'requestedAt'
        ])
        && data.uid == uid
        && data.email == request.auth.token.email
        && data.displayName is string
        && data.requestedAt == request.time;
    }

    function validAuthorizedUser(data, uid) {
      return data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'active',
          'approvedAt',
          'approvedBy'
        ])
        && data.keys().hasAll([
          'uid',
          'email',
          'displayName',
          'active',
          'approvedAt',
          'approvedBy'
        ])
        && data.uid == uid
        && data.email is string
        && data.displayName is string
        && data.active is bool
        && data.approvedAt == request.time
        && data.approvedBy == 'jsikson@gmail.com';
    }

    function validShiftDocument(data, shiftId) {
      return data.keys().hasOnly([
          'version',
          'date',
          'shift',
          'roster',
          'otSupport',
          'errorProof',
          'fixed',
          'technicians',
          'cellIds',
          'pms',
          'escalations',
          'schemaVersion',
          'createdAt',
          'createdByUid',
          'createdByEmail',
          'updatedAt',
          'updatedByUid',
          'updatedByEmail',
          'taskAudit'
        ])
        && data.keys().hasAll([
          'version',
          'date',
          'shift',
          'roster',
          'otSupport',
          'errorProof',
          'fixed',
          'technicians',
          'cellIds',
          'pms',
          'escalations',
          'schemaVersion',
          'createdAt',
          'createdByUid',
          'createdByEmail',
          'updatedAt',
          'updatedByUid',
          'updatedByEmail',
          'taskAudit'
        ])
        && data.version == 8
        && data.schemaVersion == 1
        && data.date is string
        && data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && data.shift in ['B1', 'B2', 'G1', 'G2']
        && shiftId == data.date + '_' + data.shift
        && data.roster is map
        && data.otSupport is list
        && data.errorProof is string
        && data.fixed is map
        && data.technicians is map
        && data.cellIds is map
        && data.pms is map
        && data.escalations is map
        && data.taskAudit is map
        && data.createdAt is timestamp
        && data.createdByUid is string
        && data.createdByEmail is string
        && data.updatedAt is timestamp
        && data.updatedByUid is string
        && data.updatedByEmail is string;
    }

    match /accessRequests/{uid} {
      allow get: if isOwner()
        || (verifiedUser() && request.auth.uid == uid);
      allow list, delete: if isOwner();
      allow create, update: if verifiedUser()
        && request.auth.uid == uid
        && validAccessRequest(request.resource.data, uid);
    }

    match /authorizedUsers/{uid} {
      allow get: if isOwner()
        || (verifiedUser() && request.auth.uid == uid);
      allow list, delete: if isOwner();
      allow create, update: if isOwner()
        && validAuthorizedUser(request.resource.data, uid);
    }

    match /shifts/{shiftId} {
      allow get, list: if canUseSharedShifts();

      allow create: if canUseSharedShifts()
        && validShiftDocument(request.resource.data, shiftId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.createdByEmail == request.auth.token.email
        && request.resource.data.updatedByEmail == request.auth.token.email;

      allow update: if canUseSharedShifts()
        && validShiftDocument(request.resource.data, shiftId)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.createdByEmail == resource.data.createdByEmail
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.updatedByEmail == request.auth.token.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'roster',
          'otSupport',
          'errorProof',
          'fixed',
          'technicians',
          'cellIds',
          'pms',
          'escalations',
          'updatedAt',
          'updatedByUid',
          'updatedByEmail',
          'taskAudit'
        ]);

      allow delete: if isOwner();
    }
  }
}
